{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":pinDependencies",
    "group:allNonMajor",
    "group:allDigest",
    "customManagers:dockerfileVersions",
    "customManagers:githubActionsVersions",
    "customManagers:helmChartYamlAppVersions",
    "customManagers:makefileVersions",
    "customManagers:mavenPropertyVersions",
    "customManagers:tfvarsVersions",
    "customManagers:tsconfigNodeVersions",
    "mergeConfidence:all-badges",
    "security:openssf-scorecard",
    ":enablePreCommit",
    ":semanticCommits",
    ":disableDependencyDashboard"
  ],

  "labels": ["dependencies", "no-stale"],

  "vulnerabilityAlerts": {
    "addLabels": ["security"]
  },

  "packageRules": [
    {
      "description": "Update pre-commit hooks every Monday from 00:00 to 04:00 UTC",
      "matchManagers": ["pre-commit"],
      "schedule": ["* 0-3 * * 1"]
    }
  ],

  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,

  "timezone": "UTC"
}
